# Copy this file to .env on the server (docker compose reads .env automatically)
# and adjust it there. .env is gitignored.
#
#   cp .env.example .env
#
# Must match the backend's actual PUBLIC_HOST / BACKEND_PORT (see the backend
# repo's .env) — the frontend bakes this in at BUILD time, so changing it
# requires `docker compose up -d --build`, not just a restart.

PUBLIC_HOST=167.86.120.214
BACKEND_PORT=8082
FRONTEND_PORT=3001
