# Copy this file to .env on the server (docker compose reads .env automatically)
# and adjust it there. .env is gitignored.
#
#   cp .env.example .env
#
# API_URL must match the backend's actual public address (see the backend
# repo's .env — its FRONTEND_URL must in turn match FRONTEND_PORT below).
# Baked into the client bundle at BUILD time, so changing it requires
# `full-restart`, not just a plain restart.
#
#   Raw IP:port (no reverse proxy):
#     API_URL=http://167.86.120.214:8082
#
#   Behind nginx + HTTPS on a real domain:
#     API_URL=https://api.riskycfashion.com
API_URL=http://167.86.120.214:8082

# Host port this container's frontend listens on (used for the raw IP:port
# URL above, and for nginx to proxy to once behind a domain).
FRONTEND_PORT=3001

# The site's own public address — used server-side only (sitemap.xml,
# robots.txt, canonical/Open Graph URLs), never shipped to the browser, so a
# runtime env var is enough (no rebuild needed if you change it, just a
# plain restart). Should match wherever the app is actually reachable:
#   SITE_URL=http://167.86.120.214:3001
#   SITE_URL=https://riskycfashion.com
SITE_URL=http://167.86.120.214:3001

# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# (Application type: Web application). Add both this site's real origin and
# http://localhost:3000 under "Authorized JavaScript origins" (no path, no
# trailing slash). Baked into the client bundle at BUILD time like API_URL
# above. Must be set on the BACKEND too (as GOOGLE_CLIENT_ID, same value) —
# see the backend repo's .env.
GOOGLE_CLIENT_ID=200363976946-ju1bjgpe114da4gaec0619j4m6k3di90.apps.googleusercontent.com
